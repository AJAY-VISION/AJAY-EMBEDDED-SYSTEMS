#include <stdio.h>

int main() {
    float voltage, resistance, power;

    // Input voltage and resistance
    printf("Enter Voltage (V): ");
    scanf("%f", &voltage);

    printf("Enter Resistance (Ohms): ");
    scanf("%f", &resistance);

    // Check for zero resistance
    if (resistance == 0) {
        printf("Resistance cannot be zero.\n");
        return 1;
    }

    // Calculate power
    power = (voltage * voltage) / resistance;

    // Display result
    printf("Power dissipated by resistor = %.2f Watts\n", power);

    return 0;
}

